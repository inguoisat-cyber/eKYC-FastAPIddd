PROJECT_NAME="eKYC System"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="your-super-secret-key-change-this-in-production"
ENCRYPTION_KEY="your-32-byte-base64-encoded-fernet-key"

# Database
DATABASE_URL="sqlite:///./ekyc.db"

# Storage
STORAGE_DIR="./storage"

# Limits
MAX_UPLOAD_SIZE=5242880  # 5MB
ALLOWED_MIME_TYPES=["image/jpeg", "image/png", "video/mp4", "video/webm"]

# Dev Settings
DEV_ALLOW_UPLOAD=true
