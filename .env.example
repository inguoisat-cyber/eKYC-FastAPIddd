# Tất cả đều TUỲ CHỌN. Chỉ bỏ comment dòng nào cần đổi.

# Khoá mã hoá ảnh. Trống = tự sinh và lưu ở data/fernet.key (nhớ backup file này, mất khoá là mất ảnh).
# Tạo khoá: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# FACE_MODEL=buffalo_l        # buffalo_s: nhanh hơn nhiều, kém chính xác hơn (chạy lại download_models.py)
# MATCH_THRESHOLD=0.35        # cosine similarity tối thiểu để coi là cùng người
# BLUR_MIN=20                 # độ nét tối thiểu của vùng mặt (hạ xuống nếu camera yếu bị báo "mờ" hoài)
# SESSION_TTL_MINUTES=30
# MAX_CHALLENGES=5            # số lần thử selfie mỗi phiên
# AI_CONCURRENCY=2            # số suy luận AI chạy song song (≈ số nhân CPU / 2)
# OCR_FALLBACK=false          # true: dùng EasyOCR khi không đọc được QR (cần: pip install ".[ocr]")
